FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY fe/package.json fe/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci
COPY packages/shared packages/shared
COPY backend backend
RUN npm run build -w @othelio/shared && npm run build -w @othelio/backend

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY fe/package.json fe/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci --omit=dev --workspace @othelio/backend --workspace @othelio/shared
COPY --from=build /app/backend/dist backend/dist
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY backend/scripts/migrate.cjs backend/scripts/migrate.cjs
COPY database/migrations database/migrations
CMD ["node", "backend/dist/main.js"]
