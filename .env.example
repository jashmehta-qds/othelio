# Local Base-fork configuration only. Copy this to `.env` for `npm run dev:fork`.
# Production uses a separately managed environment and must set every variable
# below to production values; do not use localhost or these fork addresses.
# Chain & Network Configuration
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
BASE_RPC_URL=http://127.0.0.1:8545

# Frontend Contract Addresses (Next.js)
NEXT_PUBLIC_CHAIN_ID=31337
# Explicitly points the browser at the local Base fork. Production must set this
# to its public Base RPC endpoint; it must never fall back to localhost.
NEXT_PUBLIC_BASE_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:3001
NEXT_PUBLIC_FACTORY_ADDRESS=0x787C53FA27340DAA779F3a1B8CDbf7936B14B68e
NEXT_PUBLIC_MODULE_ADDRESS=0xe3B1E81bB4ae2a723CF4fF23b7E66C71CC6A2330
NEXT_PUBLIC_ORACLE_ADDRESS=0x573C9a2D691daC5ff71A6b06732325d0816Ef9E7
NEXT_PUBLIC_ASSET_REGISTRY_ADDRESS=0xD344074e7F0A5A718A5EA66fc261CB24a0155Fbe
NEXT_PUBLIC_FORK_FACTORY_ADDRESS=0x787C53FA27340DAA779F3a1B8CDbf7936B14B68e
NEXT_PUBLIC_FORK_MODULE_ADDRESS=0xe3B1E81bB4ae2a723CF4fF23b7E66C71CC6A2330
NEXT_PUBLIC_FORK_ORACLE_ADDRESS=0x573C9a2D691daC5ff71A6b06732325d0816Ef9E7
NEXT_PUBLIC_FORK_ASSET_REGISTRY_ADDRESS=0xD344074e7F0A5A718A5EA66fc261CB24a0155Fbe

# Indexer Container Configuration
