# RPC & Network Configuration
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_BASE_RPC_URL=http://127.0.0.1:8545
# For Base production (8453), set a browser-restricted HTTPS RPC URL, the
# deployed contract addresses, and the public HTTPS backend URL. See the
# NEXT_PUBLIC_* entries in the repository's .env.base.example.

# API Endpoints
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Dev Mode Flag (bypasses 0x DEX calldata requirement on local Anvil)
NEXT_PUBLIC_ENABLE_MOCK_SWAPS=true
