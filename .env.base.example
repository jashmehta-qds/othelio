# Local Base-mainnet integration profile.
# Copy to .env.base and set BASE_RPC_URL to your own Base RPC endpoint.
# This profile sends real transactions when a wallet signs them.

CHAIN_ID=8453
BASE_RPC_URL=https://your-base-rpc.example
RPC_URL=https://your-base-rpc.example

# Backend, running on the host.
PORT=3002
API_PORT=3003
NODE_ENV=development
DATABASE_URL=postgresql://othelio:othelio@127.0.0.1:5434/othelio
ENABLE_MOCK_DEX_SWAPS=false

# Indexer.
# The launcher resolves this to the current Base head at first startup.
START_BLOCK=latest
INDEXER_CONFIRMATIONS=1
VALUATION_INTERVAL_SECS=3600
BATCH_SIZE=9
FACTORY_ADDRESS=0xAd21D1aACF2B3c84608e69eAa87B798d27A3915D
MODULE_ADDRESS=0x245836a679b69e16617e2055d8d809EA5858c81C
ASSET_REGISTRY_ADDRESS=0x3DB84b8e172A2b8b1634F8C630C6e2acD07424AC

# Frontend, running on the host.
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_BASE_RPC_URL=https://your-base-rpc.example
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:3003
NEXT_PUBLIC_FACTORY_ADDRESS=0xAd21D1aACF2B3c84608e69eAa87B798d27A3915D
NEXT_PUBLIC_MODULE_ADDRESS=0x245836a679b69e16617e2055d8d809EA5858c81C
NEXT_PUBLIC_ORACLE_ADDRESS=0xF80bfa9608dD9BCBC7ed270Fa341C7C423CA2DF7
NEXT_PUBLIC_ASSET_REGISTRY_ADDRESS=0x3DB84b8e172A2b8b1634F8C630C6e2acD07424AC
