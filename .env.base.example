# Local Base-mainnet integration profile. Production services need their own
# managed environment variables; this file is not a production Compose stack.
# Copy to .env.base and replace the example RPC keys with your own.
# This profile sends real transactions when a wallet signs them.

CHAIN_ID=8453
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/replace-with-server-key
RPC_URL=https://base-mainnet.g.alchemy.com/v2/replace-with-server-key
# Use an independent, capacity-backed Base RPC for production failover.
# mainnet.base.org is a rate-limited public endpoint, not a production backup.
RPC_URL_SECONDARY=https://your-secondary-base-rpc.example
# Prices use RPC_URL independently of the event scanner's failover unless overridden.
INDEXER_PRICE_RPC_URL=
# Optional capacity-backed secondary; do not use the public Base RPC.
INDEXER_PRICE_RPC_URL_SECONDARY=
INDEXER_RPC_TIMEOUT_SECS=30
INDEXER_RPC_MAX_RETRIES=3
INDEXER_RPC_CIRCUIT_FAILURES=3
INDEXER_RPC_CIRCUIT_COOLDOWN_SECS=30
INDEXER_LEASE_SECS=150
INDEXER_PRICE_MULTICALL_CHUNK_SIZE=100
INDEXER_PRICE_MULTICALL_CONCURRENCY=2
INDEXER_REGISTRY_METADATA_CONCURRENCY=8
PRICE_MAX_SOURCE_AGE_SECS=604800
PRICE_REFERENCE_NOTICE_AGE_SECS=3600

# Backend, running on the host. This localhost database is only for Compose.
# In production, use the managed PostgreSQL URL with TLS.
PORT=3002
API_PORT=3003
NODE_ENV=development
DATABASE_URL=postgresql://othelio:othelio@127.0.0.1:5434/othelio
# Production API also needs AUTH_SECRET and CORS_ORIGINS set on its host.
ENABLE_MOCK_DEX_SWAPS=false

# Indexer.
# The launcher resolves this to the current Base head at first startup.
START_BLOCK=latest
INDEXER_CONFIRMATIONS=1
VALUATION_INTERVAL_SECS=3600
BATCH_SIZE=9
# Alchemy Free allows 10-block eth_getLogs ranges. Three prefetched ranges plus
# one head read stay within the documented 300 CU/s budget when paced at 1s.
INDEXER_CATCHUP_CONCURRENCY=3
INDEXER_CATCHUP_MIN_INTERVAL_MS=1000
INDEXER_HEAD_POLL_INTERVAL_SECS=5
INDEXER_PRICE_INTERVAL_BLOCKS=10
# One complete 10-block event range may be pending while the indexer catches up.
INDEXER_ACTION_MAX_LAG_BLOCKS=10
FACTORY_ADDRESS=0xAd21D1aACF2B3c84608e69eAa87B798d27A3915D
MODULE_ADDRESS=0x245836a679b69e16617e2055d8d809EA5858c81C
ASSET_REGISTRY_ADDRESS=0x3DB84b8e172A2b8b1634F8C630C6e2acD07424AC
# Optional Base token-address -> reviewed Chainlink B20 total-return proxy map.
# Review the token/feed pair independently before adding it here. This does not approve a basket route.
B20_REVIEWED_FEEDS_JSON='{}'

# Risk Split admin. Set these after deployment to enable Risk Split owner actions.
RISK_SPLIT_FACTORY_ADDRESS=
RISK_SPLIT_SETTLEMENT_ADAPTER=
RISK_SPLIT_SETTLEMENT_ADAPTER_ADDRESS=
# Optional Chainlink feed-address -> deployed market-specific settlement adapter maps.
RISK_SPLIT_SETTLEMENT_ADAPTERS_JSON='{}'
RISK_SPLIT_FACTORY_START_BLOCK=
# Set to false to pause Risk Split event indexing without affecting baskets, prices, or Upside.
RISK_SPLIT_INDEXING_ENABLED=true
# Set to false to hide Risk Split from public navigation. Direct URLs and API remain available.
NEXT_PUBLIC_RISK_SPLIT_NAV_ENABLED=true

# Upside Markets. Continuous strike + residual contracts.
UPSIDE_FACTORY_ADDRESS=
# Default feed-specific adapter. Use the map for multiple feeds.
UPSIDE_SETTLEMENT_ADAPTER_ADDRESS=
UPSIDE_SETTLEMENT_ADAPTERS_JSON='{}'
UPSIDE_FACTORY_START_BLOCK=
NEXT_PUBLIC_UPSIDE_FACTORY_ADDRESS=

# Frontend, running on the host.
NEXT_PUBLIC_CHAIN_ID=8453
# Use a separate browser-restricted key; Alchemy throughput is account-wide.
NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/replace-with-browser-key
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:3003
NEXT_PUBLIC_FACTORY_ADDRESS=0xAd21D1aACF2B3c84608e69eAa87B798d27A3915D
NEXT_PUBLIC_MODULE_ADDRESS=0x245836a679b69e16617e2055d8d809EA5858c81C
NEXT_PUBLIC_ORACLE_ADDRESS=0xF80bfa9608dD9BCBC7ed270Fa341C7C423CA2DF7
NEXT_PUBLIC_ASSET_REGISTRY_ADDRESS=0x3DB84b8e172A2b8b1634F8C630C6e2acD07424AC
