# Server Port
PORT=3001

# Environment ('development' | 'production')
NODE_ENV=development

# Runtime network: 31337 is the local Base fork; 8453 is real Base.
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
ANVIL_RPC_URL=http://127.0.0.1:8545

# Enable direct USDC deposit fallback for local Anvil dev node without 0x API key
ENABLE_MOCK_DEX_SWAPS=false

# Base RPC used for module capability, route-approval, and simulation checks.
BASE_RPC_URL=

# Production API settings: use a managed PostgreSQL URL with TLS, a unique
# random auth secret, and the exact HTTPS frontend origin (comma-separated if
# more than one). Do not use the local defaults in production.
DATABASE_URL=postgresql://othelio:othelio@127.0.0.1:5433/othelio
AUTH_SECRET=
CORS_ORIGINS=
API_PORT=3001

# Reviewed direct Aerodrome Slipstream routes manifest.
# Defaults include all 13 Coinbase B20 tokens paired with Base USDC at tickSpacing 100.
# Set this to override or disable routes (e.g. [{"chainId":8453,"token0":"0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913","token1":"0xb200000000000000000000C2e324d24d7eEcd1fb","tickSpacing":100,"enabled":false}] to disable AAPLc)
# Leave unset or empty to use built-in reviewed defaults.
AERODROME_SLIPSTREAM_ROUTES_JSON=
